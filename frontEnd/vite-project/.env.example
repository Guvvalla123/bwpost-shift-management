# BWPost Shift Management — Frontend Environment Variables
# Copy to .env and fill in your values.

# Backend API URL (required for auth and data). Local: Render backend: see .env.production
VITE_API_URL=http://localhost:5500

# Optional: Google Calendar sign-in
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Cloudinary for profile images
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-preset
