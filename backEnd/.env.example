# .env.example
# Copy this file and rename it to .env
# Then fill in your own values for each variable.
# Never commit the real .env file — only this example file.
# This example file shows every variable the app needs.
#
# HOW TO GENERATE SECRETS:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run that command twice — once for JWT_SECRET, once for REFRESH_TOKEN_SECRET.

# ── DATABASE ────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ── SERVER ──────────────────────────────────
PORT=5500
NODE_ENV=development

# ── JWT ACCESS TOKEN ────────────────────────
JWT_SECRET=your_long_random_secret_here_generate_with_crypto_randomBytes
JWT_EXPIRES_IN=15m

# ── JWT REFRESH TOKEN ───────────────────────
REFRESH_TOKEN_SECRET=another_long_random_secret_must_be_different_from_jwt_secret
REFRESH_TOKEN_EXPIRES_IN=8h

# ── CORS AND FRONTEND ───────────────────────
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── SECURITY ────────────────────────────────
HEALTH_CHECK_SECRET=
PASSWORD_RESET_EXPIRE_MS=3600000

# ── SEED SCRIPTS ────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123!
SEED_ADMIN_USERNAME=Admin

# ── BACKUP SYSTEM ───────────────────────────
BACKUP_ENCRYPTION_PASSWORD=your_strong_backup_password
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json
BACKUP_RETENTION_DAYS=30
