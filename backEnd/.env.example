# Copy to .env and fill in secrets. Do not commit .env.
#
# CORS: list every origin the browser will use to call this API.
ALLOWED_ORIGINS=https://bwpost-shift-management.vercel.app,http://localhost:5173
#
# Used to build user-facing links (register, password reset). Must be the deployed frontend base URL in production.
FRONTEND_URL=https://bwpost-shift-management.vercel.app
#
# MONGO_URI, JWT_SECRET, REFRESH_TOKEN_SECRET, etc. are required — see your team docs or local template.
