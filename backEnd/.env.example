# BWPost Shift Management — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Required
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=your-64-char-hex-secret
REFRESH_TOKEN_SECRET=your-64-char-hex-secret

# Optional (defaults shown)
# ALLOWED_ORIGINS=https://bwpost-shift-management.vercel.app,http://localhost:5173
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PORT=5500
NODE_ENV=development

# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
