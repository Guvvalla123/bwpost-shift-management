# Copy this file to .env and fill in your values
# Never commit the .env file to GitHub

# ── DATABASE ──────────────────────────────────
# Your MongoDB connection string from Atlas
MONGO_URI=your_mongodb_connection_string_here

# ── SERVER ────────────────────────────────────
# Port the server runs on
PORT=5500

# Set to production when deploying
NODE_ENV=development

# ── JWT TOKENS ────────────────────────────────
# Secret key for creating access tokens
# Must be a long random string
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here

# How long the access token lasts
# 15m means 15 minutes
JWT_EXPIRES_IN=15m

# Secret key for refresh tokens
# Must be DIFFERENT from JWT_SECRET
REFRESH_SECRET=your_long_random_refresh_secret_here

# How long the refresh token lasts
# 7d means 7 days
REFRESH_EXPIRES_IN=7d

# ── FRONTEND ──────────────────────────────────
# URL of the React frontend
# Used when creating invite links
FRONTEND_URL=http://localhost:5173

# Allowed origins for CORS
# Add comma separated URLs if multiple
ALLOWED_ORIGINS=http://localhost:5173
